# ===== vaultwarden FreeBSD (PostgreSQL) 配置模板 =====
# 部署时复制并填写：cp .env.example .env
# 完整配置项参考：https://github.com/dani-garcia/vaultwarden/blob/main/.env.template

# 监听地址与端口（serv00 上用 127.0.0.1，由面板反代对外）
ROCKET_ADDRESS=127.0.0.1
ROCKET_PORT=12080

# 数据目录（默认是部署目录下的 data/，可不填）
# DATA_FOLDER=/home/user/vaultwarden/data

# 必填：PostgreSQL 连接串
DATABASE_URL=postgresql://user:pass@host:5432/vaultwarden

# Web Vault 前端目录（可选，仅当同时部署了 web-vault 前端时填写）
# WEB_VAULT_FOLDER=/home/user/vaultwarden/web-vault

# 注册与邀请
SIGNUPS_ALLOWED=true
INVITATIONS_ALLOWED=false

# WebSocket 通知
WEBSOCKET_ENABLED=true

# 必填：管理后台令牌，生成方式：openssl rand -base64 48
# 管理后台地址：https://你的域名/admin
ADMIN_TOKEN=

# 必填：外部访问域名（serv00 面板反代后使用）
DOMAIN=https://your.domain

# ===== 以下为可选配置（按需取消注释） =====

# 发送邮件（SMTP）
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=user@example.com
# SMTP_PASSWORD=secret
# SMTP_FROM=vaultwarden@example.com

# 上传附件大小限制（默认 10MB）
# SIGNUPS_VERIFY=false

# 会话与安全
# SHOW_PASSWORD_HINT=false
